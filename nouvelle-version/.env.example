# ─────────────────────────────────────────────────────────────────────────────
# Beauté Halal v3 — variables du site public
# Copiez ce fichier en « .env.local » pour vos surcharges locales.
#
# ⚠️ Tout ce qui est ici est lu AU MOMENT DU BUILD et devient public :
#    aucun secret, aucun mot de passe, aucune clé privée.
# ─────────────────────────────────────────────────────────────────────────────

# API commune aux trois sites, préfixe « /api » inclus.
VITE_API_URL=https://backend-beaute-halal.aeemci-ce.ci/api

# Adresse publique de CE site (sans barre finale) : canonical, Open Graph, sitemap.
# Laissez vide tant que le domaine n'est pas décidé : le site utilise alors
# l'origine du navigateur.
VITE_SITE_URL=

# Indexation par les moteurs de recherche : « true » ou « false ».
# Les trois sites ont des contenus proches : n'activez « true » que sur le site
# que vous choisissez de faire référencer (voir README, section SEO).
VITE_ALLOW_INDEXING=false
