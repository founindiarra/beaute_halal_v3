# Développement — les appels API passent par le proxy Vite (vite.config.js) :
# le navigateur reste en même origine, donc plus aucun blocage CORS, même quand
# le site est partagé sur le réseau local (http://IP:5173).
# Pour tester la réservation sans toucher aux données réelles : « npm run dev:mock »
# puis, dans .env.local : VITE_API_URL=http://localhost:4010/api
VITE_API_URL=/api
VITE_SITE_URL=
VITE_ALLOW_INDEXING=false
